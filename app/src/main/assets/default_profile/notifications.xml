<?xml version="1.0" encoding="UTF-8"?>
<NOTIFICATIONS>

<show_notifications value="true"/>
<app_notification_enabled_default value="false"/>
<default_notification_color value="#ffffff"/>
<!--notification_format value="%[#E4F34A]title %n%[#ffffff]text"-->

<notification_format value="%n %app | (%t1) %n[ root@system ] %n╠═══(%[#39FF14]title) %n╚══════════⫸%[#00FF00]text"/>
<click_notification value="true"/>
<long_click_notification value="true"/>
<notification_popup_exclude_app value="true"/>
<notification_popup_exclude_notification value="true"/>
<notification_popup_reply value="true"/>
<!-- ================= ENABLED APPS ================= -->

<!-- Telegram -->
<org.telegram.plus enabled="true" color="#FF0088cc" format="1"/>

<!-- WhatsApp -->
<com.whatsapp enabled="true" color="#FF50fa7b" format="2"/>

<!-- Twitter -->
<com.twitter.android enabled="true" color="#FF01C9FC" format="3"/>

<!-- Instagram -->
<com.instagram.android enabled="true" color="#FFFC01C9" format="4"/>
<com.instapro.android enabled="true" color="#36747d" format="33"/>

<!-- Phone / Calls -->
<com.android.dialer enabled="true" color="#FF8be9fd" format="5"/>
<com.android.incallui enabled="true" color="#FF8be9fd" format="5"/>

<!-- SMS -->
<com.android.providers.telephony enabled="true" color="#ffffb86c" format="6"/>
<com.google.android.apps.messaging enabled="true" color="#ffffb86c" format="6"/>

<!-- Gmail -->
<com.google.android.gm enabled="true" color="#fff0ff4a" format="7"/>

<!-- Spotify -->
